<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit as an MSIX package for the Microsoft Store. pack.ps1 fills in the $TOKENS$. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$NAME$" Publisher="$PUBLISHER$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DISPLAYNAME$</DisplayName>
    <PublisherDisplayName>$PUBLISHERNAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Select files, press Alt+Q, and act on them from a glass ring.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Orbit" Executable="orbit.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="$DISPLAYNAME$" Description="Select files, press Alt+Q, and act on them from a glass ring."
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Orbit waits in the tray for Alt+Q, so it starts with Windows; switchable in Settings > Apps > Startup -->
        <desktop:Extension Category="windows.startupTask" Executable="orbit.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="OrbitStartup" Enabled="true" DisplayName="Orbit" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
